#!/usr/bin/env bash
# polish — open the AI rewrite popup for the selected text.
#   polish                       use the primary selection (whatever is highlighted)
#   polish --file F [--style S] [--editable yes|no]   (used by the browser extension)
set -uo pipefail
DIR=$(dirname "$(readlink -f "$0")")
style=proofread editable=unknown file=""
while (($#)); do
  case $1 in
    --style) style=$2; shift 2 ;;
    --file) file=$2; shift 2 ;;
    --editable) editable=$2; shift 2 ;;
    *) echo "unknown arg $1" >&2; exit 2 ;;
  esac
done
run="${XDG_RUNTIME_DIR:-/tmp}/text-polish"; mkdir -p -m 700 "$run"
input="$run/input.txt"
if [[ -n $file ]]; then
  cp -- "$file" "$input"
  [[ $file == "$run"/browser-*.txt ]] && rm -f -- "$file"
else
  timeout 2 wl-paste --primary --no-newline --type text >"$input" 2>/dev/null || : >"$input"
fi
if [[ -z $(tr -d '[:space:]' <"$input") ]]; then
  notify-send -a "Polish" "Polish" "Select some text first."
  exit 0
fi
head -c 20000 "$input" >"$input.tmp" && mv "$input.tmp" "$input"

export POLISH_INPUT=$input POLISH_STYLE=$style POLISH_EDITABLE=$editable POLISH_DIR=$DIR
export POLISH_WINDOW=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')
export POLISH_MONITOR=$(hyprctl monitors -j 2>/dev/null | jq -r '.[]|select(.focused).name')
pkill -f "quickshell -p $DIR/shell.qml" 2>/dev/null
exec setsid -f quickshell -p "$DIR/shell.qml" >"$run/popup.log" 2>&1 </dev/null
